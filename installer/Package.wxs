<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="KeepstoneBackup"
           Manufacturer="KeepstoneBackup Contributors"
           Version="$(ProductVersion)"
           UpgradeCode="4bc9a583-4b7f-436e-8eb8-ebb4afbb0039"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="KeepstoneBackup backup agent" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of KeepstoneBackup is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="KeepstoneBackupIcon" SourceFile="keepstonebackup.ico" />
    <Property Id="ARPPRODUCTICON" Value="KeepstoneBackupIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/nimatalebi/Storix" />
    <Property Id="ARPHELPLINK" Value="https://github.com/nimatalebi/Storix/issues" />
    <Property Id="ARPCONTACT" Value="nimatweb@gmail.com" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="KeepstoneBackup" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShortcutFolder" Name="KeepstoneBackup" />
    </StandardDirectory>

    <Feature Id="Main" Title="KeepstoneBackup" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="ShortcutComponent" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
  </Package>

  <Fragment>
    <!-- Everything from the publish folder except the service executable (installed below). -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.publish)**">
        <Exclude Files="!(bindpath.publish)KeepstoneBackup.Service.exe" />
        <Exclude Files="!(bindpath.publish)**.pdb" />
      </Files>
    </ComponentGroup>

    <Component Id="ServiceComponent" Directory="INSTALLFOLDER" Bitness="always64">
      <File Id="KeepstoneBackupServiceExe" Source="!(bindpath.publish)KeepstoneBackup.Service.exe" KeyPath="yes" />
      <ServiceInstall Id="KeepstoneBackupServiceInstall"
                      Name="KeepstoneBackup"
                      DisplayName="KeepstoneBackup Backup Agent"
                      Description="KeepstoneBackup scheduled backup agent (files, SQL Server, MongoDB)."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem">
        <ServiceConfig DelayedAutoStart="yes" OnInstall="yes" OnReinstall="yes" />
        <util:ServiceConfig FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="60"
                            ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="KeepstoneBackupServiceControl" Name="KeepstoneBackup" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
    </Component>

    <Component Id="ShortcutComponent" Directory="ShortcutFolder" Guid="*">
      <Shortcut Id="ManagerShortcut"
                Name="KeepstoneBackup Manager"
                Description="Configure KeepstoneBackup backup jobs"
                Target="[INSTALLFOLDER]KeepstoneBackup.Manager.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\KeepstoneBackup" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
